{
   "$schema": "https://www.krakend.io/schema/v3.json",
   "version": 3,
   "disable_access_log": true,
   "name": " - LOCAL",
   "host": [ "127.0.0.1" ],
   "port": 8080,
   "timeout": "30s",
   "cache_ttl": "300s",
   "extra_config": {
      "security/cors": {
  "allow_origins": [
    "http://localhost:5173",
    "http://localhost:5174",
    "https://2a89936da485.ngrok-free.app",
     "https://writeful-fe.onrender.com",
    "null"
  ],
  "allow_methods": [
    "POST",
    "GET",
    "PUT",
    "PATCH",
    "DELETE",
    "OPTIONS"
  ],
  "allow_headers": [
    "Origin",
    "Authorization",
    "Content-Type",
    "Accept",
    "X-User-ID",
    "Accept-Encoding",
    "Accept-Language"
  ],
  "expose_headers": [
    "Content-Length",
    "Content-Type",
    "X-User-ID"
  ],
  "allow_credentials": true,
  "max_age": "12h"
}

,
       "telemetry/metrics": {
    "collection_time": "60s",
    "listen_address": ":8090"
}
,
 "telemetry/logging": {
    "level": "DEBUG",
    "prefix": "[LOCAL-Writeful]",
    "syslog": false,
    "stdout": true,
    "format":"default"
}


,
      "router": {
         "hide_version_header": true
      }
   },
   "endpoints": [
      {
    "@comment": "Health Check",
    "endpoint": "/health",
    "method": "GET",
    "output_encoding": "json",
    "backend": [{"host": ["http://no_baz"], "url_pattern": "/"}],
    "extra_config": {
        "proxy": {
            "static": {
                "strategy": "errored",
                "data": {
                    "status": "OK"
                }
            }
        }
    }
},
{
  "@comment": "get user profile",
  "endpoint": "/auth/api/v1/user/profile",
  "method": "GET",
  "input_query_strings": ["*"]
,
  "input_headers": [
  "Content-Type",
  "Authorization",
  "X-User-ID",
  "X-User-Amaze-ID",
  "X-Client-ID",
  "X-Client-Name",
  "X-Client-Role",
  "X-API-Key",
  "X-Language-Key"
]
,
  "output_encoding": "no-op",
  "backend": [
    {
      "host": ["http://auth-service:8004"],
      "url_pattern": "/api/v1/user/profile",
      "method": "GET",
      "encoding": "json",
      "extra_config": {
        "backend/http": {
          "return_error_code": true
        }
      }
    }
  ],
  "extra_config": {
    "auth/validator": {
  "alg": "HS256",
  "kid": "SIM2",
  "jwk_local_path": "/jwk/symmetric_dev.json",
  "disable_jwk_security": true,
  "roles": [],
  "propagate_claims": [
      ["id", "X-User-ID"]
  ]
}
  }
},
