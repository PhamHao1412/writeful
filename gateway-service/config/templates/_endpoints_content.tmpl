{
  "@comment": "get posts",
  "endpoint": "/content/api/v1/post",
  "method": "GET",
  {{ include "endpoints/input_query_strings.tmpl" }},
  {{ include "endpoints/input_headers.tmpl" }},
  "output_encoding": "no-op",
  "backend": [
    {
      "host": ["{{ .env.backend_hosts.host_content }}"],
      "url_pattern": "/api/v1/post",
      "method": "GET",
      "encoding": "json",
      "extra_config": {
        "backend/http": {
          "return_error_code": true
        }
      }
    }
  ],
    "extra_config": {
    }
},
